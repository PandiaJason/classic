*.import
*.translation

# Android
/android/

# Exported binaries (not source code)
exports/

# Mono/C#
.mono/
data_*/
mono_crash.*.json

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.vercel
